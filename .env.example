# FOSSCast configuration
# Copy to .env and fill in. Never commit .env.
#
# There is very little here on purpose. FOSSCast's own settings - the
# login, the site's address, uploads - live inside
# FOSSCast, on the Settings and Account pages, and are set the first
# time you open it in a browser. What is left is what Docker needs
# before anything is running.

# The public domain the site runs at. This is here for the proxy: Caddy
# has to ask for a certificate in that name before FOSSCast exists, so
# it cannot read the name out of FOSSCast's settings.
#
# FOSSCast reads it once, on the first start, and copies it into its own
# settings; after that the Settings page is where it is changed and this
# line can go.
DOMAIN=fosscast.example.com

# Host port the app is published on (change it only when several
# FOSSCast instances share one machine; inside the container the port
# never changes). Loopback only; the reverse proxy sends traffic here.
HTTP_PORT=3100

# Optional: the address the app port is published on. Default 127.0.0.1,
# reachable only by a proxy on the same host. Set to a Tailscale IP for
# a tailnet-only instance, or 0.0.0.0 if your proxy runs in a separate
# container or on another host. Never expose the app port itself to the
# open internet.
#BIND_HOST=127.0.0.1

# Optional: make the first run print a six-digit setup code and ask for
# it before anybody can claim the instance. Off by default, because the
# first person to open an unclaimed FOSSCast is normally the person who
# has just installed it, and being sent to a log was in their way. Turn
# it on where the address is reachable from the internet before you get
# to it: the code lives in memory only, is never written to disk, and
# changes on every restart. Read it with `docker compose logs app`.
#REQUIRE_SETUP_CODE=1

# Set to 1 for a public demonstration instance: the whole instance
# becomes read-only (no settings changes and no uploads), the
# login page shows the credentials, and a banner says so. Anyone can be
# handed the login without being able to spoil it for the next visitor.
# A demo needs an account to hand out, so it is the one case where the
# two variables below still earn their place.
#DEMO_MODE=1
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
