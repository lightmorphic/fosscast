# FOSSCast configuration
# Copy to .env and fill in. Never commit .env.

# The public domain the site runs at
DOMAIN=fosscast.example.com

# Host ports (change these only when running several FOSSCast instances
# on one machine; inside the containers the ports never change).
# App, loopback only; the reverse proxy sends traffic here.
HTTP_PORT=3100

# Optional: the address the app and HLS ports are published on. Default
# 127.0.0.1, reachable only by a proxy on the same host. Set to a
# Tailscale IP for a tailnet-only instance, or 0.0.0.0 if your proxy
# runs in a separate container or on another host. Never expose the app
# port itself to the open internet.
#BIND_HOST=127.0.0.1

# Optional: the hostname studios use for RTMP ingest, shown on the
# dashboard's Stream page (defaults to DOMAIN). Set this when DOMAIN
# points somewhere that cannot carry RTMP, such as a Cloudflare Tunnel
# or a proxied DNS record: ingest must reach this server directly, so
# use an unproxied hostname or the raw server IP.
#INGEST_HOST=
# RTMP ingest, public. Non-default values mean studios must include the
# port in their stream URL: rtmp://domain:port/live
RTMP_PORT=1935
# HLS out, loopback only.
HLS_PORT=8888

# First admin account, created automatically on first start when no
# accounts exist yet. Log in at /admin and change the password from the
# Account page; after that these two values are ignored.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stream keys are per show and live in the dashboard (Stream page),
# not here. Create a show and its key appears.

# Token the studio will use to publish episodes through the API (the API
# is under construction; set it now so it never needs a config change).
# Generate with: openssl rand -hex 32
PUBLISHER_TOKEN=

# Email settings for reminders (any standard SMTP provider). Optional:
# without them, emails are simply skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: a podping.cloud auth token (free, from the Podcast Index
# folks). When set, going live pings the network so Podcasting 2.0
# apps see the liveItem straight away.
PODPING_TOKEN=
