# FOSSCast configuration
# Copy to .env and fill in. Never commit .env.

# The public domain the site runs at
DOMAIN=fosscast.example.com

# Host port the app is published on (change it only when several
# FOSSCast instances share one machine; inside the container the port
# never changes). Loopback only; the reverse proxy sends traffic here.
HTTP_PORT=3100

# Optional: the address the app and HLS ports are published on. Default
# 127.0.0.1, reachable only by a proxy on the same host. Set to a
# Tailscale IP for a tailnet-only instance, or 0.0.0.0 if your proxy
# runs in a separate container or on another host. Never expose the app
# port itself to the open internet.
#BIND_HOST=127.0.0.1

# First admin account, created automatically on first start when no
# accounts exist yet. Log in at /admin and change the password from the
# Account page; after that these two values are ignored.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# Set to 1 for a public demonstration instance: the whole instance
# becomes read-only (no settings changes, uploads, publishing or chat),
# the login page shows the credentials, and a banner says so. Anyone
# can be handed the login without being able to spoil it for the next
# visitor.
#DEMO_MODE=1

# The key FOSSStudio (or any other studio) uses to publish finished
# recordings into this instance through the API. Leave it empty and one
# is generated on first start; set the same value at both ends to link
# them. Generate with: openssl rand -hex 32
# (Instances that already set PUBLISHER_TOKEN keep working: the old name
# is still read, and an existing token is never rotated.)
FOSSSTUDIO_TOKEN=

# Email settings for reminders (any standard SMTP provider). Optional:
# without them, emails are simply skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

